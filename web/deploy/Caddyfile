{$SITE_ADDRESS:localhost} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /oauth/* {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy frontend:3000
    }
    header {
        X-Content-Type-Options nosniff
        # 邮箱验证与密码恢复使用一次性链接，代理层保持页面的来源保密策略。
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
