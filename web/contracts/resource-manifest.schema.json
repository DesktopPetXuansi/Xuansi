{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xuansi:resource-manifest:1",
  "title": "玄司资源包清单 v1",
  "type": "object",
  "required": ["schemaVersion", "resourceId", "resourceVersionId", "kind", "version", "entrypoint", "minimumClientVersion", "files", "dependencies"],
  "properties": {
    "schemaVersion": {"const": 1},
    "resourceId": {"type": "string", "format": "uuid"},
    "resourceVersionId": {"type": "string", "format": "uuid"},
    "kind": {"enum": ["MODEL", "MOTION", "EXPRESSION", "IMAGE", "ANIMATION"]},
    "version": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "minimumClientVersion": {"type": "string"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {
        "type": "object", "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "dependencies": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "required": ["resourceId", "resourceVersionId", "kind", "relation"],
        "properties": {
          "resourceId": {"type": "string", "format": "uuid"},
          "resourceVersionId": {"type": "string", "format": "uuid"},
          "kind": {"enum": ["MODEL", "MOTION", "EXPRESSION", "IMAGE", "ANIMATION"]},
          "relation": {"type": "string", "enum": ["TARGET_MODEL", "REQUIRED"]}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "parameters": {"type": "object", "additionalProperties": {"type": "string"}},
        "motions": {"type": "array", "items": {"type": "string"}},
        "expressions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
