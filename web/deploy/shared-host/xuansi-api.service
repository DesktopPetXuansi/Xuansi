# 共享主机上的完整 API；与旧独立反馈进程使用同一数据库，切换时只保留完整 worker。
[Unit]
Description=Xuansi website API
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=xuansi-web
Group=xuansi-web
WorkingDirectory=/opt/xuansi/web-current
EnvironmentFile=/opt/xuansi/shared/web.env
Environment=GOMEMLIMIT=64MiB
Environment=GOMAXPROCS=1
ExecStartPre=/opt/xuansi/web-current/api -migrate-only
ExecStart=/opt/xuansi/web-current/api
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=128M
MemoryMax=160M
TasksMax=64

[Install]
WantedBy=multi-user.target
