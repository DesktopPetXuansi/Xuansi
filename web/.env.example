# 本机开发使用 compose.yaml 的回环数据库与邮件捕获服务。
DATABASE_URL=postgres://xuansi@127.0.0.1:54329/xuansi?sslmode=disable
APP_ENV=development
APP_URL=http://localhost:3000
HTTP_ADDRESS=127.0.0.1:8080
API_ORIGIN=http://127.0.0.1:8080
STORAGE_DRIVER=local
STORAGE_PATH=../.data/storage
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
# 本机 Next 开发代理；Go 端口不得向公网暴露。生产改成实际代理来源。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
MAX_UPLOAD_BYTES=536870912
USER_QUOTA_BYTES=2147483648

# 生产值通过服务环境或秘密管理提供，示例不包含真实凭据。
OAUTH_SECRET=
SMTP_USER=
SMTP_PASSWORD=
# 暂停所有对外邮件并拒绝新的注册/验证/重置请求；其他后台任务继续运行。
MAIL_DELIVERY_DISABLED=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 可选：后台同步反馈到 GitHub，凭据只由 Go 服务读取。
# 公开仓库必须显式 true，且每条反馈必须包含用户的 publicConsent。
FEEDBACK_GITHUB_REPOSITORY=
FEEDBACK_GITHUB_PUBLIC=false
FEEDBACK_GITHUB_TOKEN=

# 可选匿名访问统计；全部留空时关闭采集，GitHub 安装包下载计数独立可用。
# 公共来源只用于 /script.js；API 地址和密钥仅由 Go 服务读取。
UMAMI_PUBLIC_URL=
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
