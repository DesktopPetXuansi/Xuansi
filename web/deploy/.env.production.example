# 复制到仓库外的受限环境文件后填写；这里都是占位值。
SITE_ADDRESS=pet.example.com
APP_URL=https://pet.example.com
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://xuansi:replace-with-a-random-database-password@db:5432/xuansi?sslmode=disable
OAUTH_SECRET=replace-with-a-stable-random-secret-of-at-least-32-characters
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=xuansi-resources
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@pet.example.com
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# 用户指定的公开反馈仓库；启用时填写仅此仓库 Issues:write 的服务端凭据。
# 保持仓库和令牌同时为空可关闭同步，继续私有收件。
FEEDBACK_GITHUB_REPOSITORY=
FEEDBACK_GITHUB_PUBLIC=false
FEEDBACK_GITHUB_TOKEN=
