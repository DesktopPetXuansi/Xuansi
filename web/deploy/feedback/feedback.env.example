# 仅部署反馈，不需要 SMTP、S3 或 OAuth。真实文件放在仓库外并 chmod 600。
APP_ENV=production
APP_URL=https://xuansi.kukude.top
HTTP_ADDRESS=172.17.0.1:18188
DATABASE_URL=postgres://xuansi_feedback_app:REPLACE_ON_SERVER@127.0.0.1:15432/xuansi_feedback?sslmode=disable
# 必须核对现有 Nginx 容器的实际地址；重新创建容器后需一并更新。
TRUSTED_PROXY_CIDRS=172.17.0.3/32
