{$SITE_ADDRESS:localhost} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /oauth/* {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy frontend:3000
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
